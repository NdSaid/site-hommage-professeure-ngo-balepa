---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config";
import {
  languages,
  otherLang,
  path,
  t,
  type Lang,
  type RouteKey,
} from "../i18n";

interface Props {
  lang: Lang;
  /** Vue courante — sert au lien actif et au sélecteur de langue. */
  route: RouteKey;
  title?: string;
  description?: string;
}

const { lang, route, title, description } = Astro.props;
const d = t(lang);
const other = otherLang(lang);

const pageTitle = title
  ? `${title} — ${site.shortName}`
  : `${site.shortName} — ${d.meta.siteTitle}`;
const pageDescription = description ?? d.meta.description;

const canonical = new URL(path(lang, route), Astro.site ?? Astro.url);
const alternate = new URL(path(other, route), Astro.site ?? Astro.url);
---

<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`.replace(/\/+/g, "/")}
    />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    {site.draft && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical.href} />
    <link
      rel="alternate"
      hreflang={languages[lang].htmlLang}
      href={canonical.href}
    />
    <link
      rel="alternate"
      hreflang={languages[other].htmlLang}
      href={alternate.href}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(path("fr", route), Astro.site ?? Astro.url).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />

    {/* Posé avant peinture : sans JavaScript, aucun bloc n'est masqué. */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    {/* Fondu enchaîné entre les pages plutôt qu'un flash blanc. */}
    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,300;0,400;0,500;1,300&family=Public+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header lang={lang} route={route} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Révèle les blocs à l'approche du viewport.
      //
      // Trois déclencheurs volontairement redondants. Un contenu resté
      // invisible serait bien pire qu'une absence d'animation, et
      // `astro:page-load` seul s'est révélé faillible : il peut ne jamais
      // survenir si le routeur échoue à s'initialiser.
      let armed = false;

      function armReveals() {
        const blocks = document.querySelectorAll<HTMLElement>(
          ".reveal:not([data-revealed])",
        );
        armed = true;
        if (!blocks.length) return;

        const reduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        if (reduced || !("IntersectionObserver" in window)) {
          blocks.forEach((el) => {
            el.dataset.revealed = "";
            el.classList.add("is-visible");
          });
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              // Décalage en cascade à l'intérieur d'un groupe.
              const group = el.closest("[data-stagger]");
              if (group) {
                const peers = [...group.querySelectorAll(".reveal")];
                el.style.transitionDelay = `${peers.indexOf(el) * 70}ms`;
              }
              el.classList.add("is-visible");
              observer.unobserve(el);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.06 },
        );

        blocks.forEach((el) => {
          el.dataset.revealed = "";
          observer.observe(el);
        });
      }

      // Fondu des photographies dès que le fichier est décodé.
      function armImages() {
        document
          .querySelectorAll<HTMLImageElement>(".frame-img")
          .forEach((img) => {
            if (img.complete) img.classList.add("is-loaded");
            else
              img.addEventListener(
                "load",
                () => img.classList.add("is-loaded"),
                { once: true },
              );
          });
      }

      function arm() {
        armReveals();
        armImages();
      }

      // 1. Premier rendu, sans dépendre du routeur.
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", arm, { once: true });
      } else {
        arm();
      }

      // 2. Navigations côté client.
      document.addEventListener("astro:page-load", arm);

      // 3. Filet de sécurité : si rien ne s'est armé, tout redevient visible.
      window.setTimeout(() => {
        if (armed) return;
        document
          .querySelectorAll<HTMLElement>(".reveal")
          .forEach((el) => el.classList.add("is-visible"));
      }, 2000);
    </script>
  </body>
</html>
