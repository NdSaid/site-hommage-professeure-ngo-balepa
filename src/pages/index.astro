---
import Layout from "../layouts/Layout.astro";
import Frame from "../components/Frame.astro";

const themes = [
  {
    title: "Douala",
    text: "Son université, son terrain, sa ville d'enseignement.",
  },
  {
    title: "Industrialisation",
    text: "Les effets de l'industrie sur les territoires camerounais.",
  },
  {
    title: "Développement",
    text: "Le développement lu à l'échelle des lieux et des populations.",
  },
];
---

<Layout>
  <!-- Hero -->
  <section
    class="mx-auto grid max-w-[1180px] items-end gap-[clamp(36px,5vw,72px)] px-[clamp(20px,4vw,40px)] pt-[clamp(56px,8vw,104px)] pb-[clamp(48px,6vw,80px)]"
    style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));"
  >
    <div>
      <p class="eyebrow">In memoriam</p>
      <h1 class="mb-7 text-[clamp(40px,6.4vw,72px)]" style="max-width: 12ch;">
        Professeure Aurore Sara Ngo Balepa
      </h1>

      <p class="lede text-[clamp(17px,1.8vw,20px)]" style="max-width: 48ch;">
        Géographe, enseignante-chercheure au Département de Géographie de
        l'Université de Douala. Cheffe de département, puis Vice-Doyenne de la
        Faculté des Lettres et Sciences Humaines.
      </p>
      <p class="mt-3 text-[15px] text-muted italic" style="max-width: 48ch;">
        Geographer and researcher at the University of Douala. Head of the
        Geography Department, later Vice-Dean of the Faculty of Arts and
        Humanities.
      </p>

      <div class="mt-[34px] flex flex-wrap gap-2.5">
        <a href="/biographie/" class="btn btn-primary no-underline"
          >Découvrir son parcours</a
        >
        <a href="/livre-d-or/" class="btn btn-secondary no-underline"
          >Laisser un message</a
        >
      </div>
    </div>

    <Frame
      name="portrait"
      ratio="4/5"
      alt="Portrait de la Professeure Aurore Sara Ngo Balepa"
      caption="Portrait — légende et date à préciser"
    />
  </section>

  <!-- Bandeau thèmes -->
  <section class="border-y border-line bg-paper">
    <div
      class="mx-auto grid max-w-[1180px] gap-10 px-[clamp(20px,4vw,40px)] py-[clamp(40px,5vw,64px)]"
      style="grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));"
    >
      {
        themes.map(({ title, text }) => (
          <div>
            <h2 class="font-serif text-[26px]">{title}</h2>
            <p class="mt-3 mb-0 text-[15px] text-muted">{text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Un enseignement, une école -->
  <section
    class="mx-auto grid max-w-[1180px] items-center gap-[clamp(36px,5vw,72px)] px-[clamp(20px,4vw,40px)] py-[clamp(56px,7vw,96px)]"
    style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));"
  >
    <div>
      <h2 class="h2" style="max-width: 14ch;">Un enseignement, une école</h2>
      <p class="mt-6 text-muted" style="max-width: 40ch;">
        Des promotions d'étudiants formées à la géographie à Douala. Ce site
        rassemble ses travaux, sa carrière et les hommages de celles et ceux qui
        l'ont connue.
      </p>
      <a href="/travaux/" class="link-underline no-underline"
        >Voir les travaux</a
      >
    </div>

    <Frame
      name="enseignement"
      ratio="16/10"
      alt="Photographie d'enseignement"
      caption="Photographie — légende à préciser"
    />
  </section>
</Layout>
