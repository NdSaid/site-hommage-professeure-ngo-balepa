---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import { site } from "../config";

// Optional portrait: drop a file at src/assets/portrait.jpg (or .png/.webp).
// Using a glob rather than a direct import means the build still succeeds
// while no photograph has been added yet.
const found = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/portrait.{jpg,jpeg,png,webp}",
  { eager: true },
);
const portrait = Object.values(found)[0]?.default;
---

<Layout>
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-6 pt-16 pb-4 sm:pt-28">
    <div class="flex flex-col gap-12 sm:flex-row sm:items-start">
      {
        portrait ? (
          <Image
            src={portrait}
            alt={`Portrait of ${site.name}`}
            width={280}
            densities={[1, 2]}
            class="w-48 shrink-0 rounded-sm border border-rule shadow-sm sm:w-64"
          />
        ) : (
          <div
            class="flex aspect-[4/5] w-48 shrink-0 items-center justify-center rounded-sm border border-dashed border-rule bg-parchment-deep p-4 text-center text-xs text-ink-faint sm:w-64"
            aria-hidden="true"
          >
            Add a portrait at
            <br />
            src/assets/portrait.jpg
          </div>
        )
      }

      <div class="pt-2">
        <h1 class="font-serif text-4xl leading-tight text-ink sm:text-6xl">
          {site.name}
        </h1>
        <p class="mt-4 font-serif text-xl text-ink-soft italic">
          {site.born} – {site.died}
        </p>
        <p class="mt-6 max-w-md text-ink-soft">{site.honorific}</p>
        <div class="mt-8 h-px w-24 bg-accent-soft"></div>
      </div>
    </div>
  </section>

  <!-- Remembrance -->
  <section class="mx-auto max-w-5xl px-6 pt-16">
    <h2 class="font-serif text-2xl text-ink">In Memoriam</h2>

    <div class="prose-memorial mt-6">
      <p>
        Write her remembrance here. This is the heart of the site — the piece
        that tells a visitor who she was, not just what she accomplished. Two or
        three paragraphs is usually right.
      </p>
      <p>
        Consider covering: where she came from and what drew her to her field;
        the question or idea that occupied her; what she was like to be taught
        by, or to work alongside; and what she left behind in the people she
        trained.
      </p>
      <p>
        Edit this text in <code>src/pages/index.astro</code>.
      </p>
    </div>

    <!-- Onward links -->
    <nav
      aria-label="Explore"
      class="mt-16 grid gap-px overflow-hidden rounded-sm border border-rule bg-rule sm:grid-cols-3"
    >
      {
        [
          {
            href: "/career/",
            title: "Education & Career",
            blurb: "Her degrees, appointments, and honors.",
          },
          {
            href: "/work/",
            title: "Her Work",
            blurb: "Publications, books, and talks.",
          },
          {
            href: "/tributes/",
            title: "Tributes",
            blurb: "Remembrances from those who knew her.",
          },
        ].map(({ href, title, blurb }) => (
          <a
            href={href}
            class="group bg-surface p-6 transition-colors hover:bg-parchment-deep"
          >
            <h3 class="font-serif text-lg text-ink group-hover:text-accent">
              {title}
            </h3>
            <p class="mt-2 text-sm text-ink-soft">{blurb}</p>
          </a>
        ))
      }
    </nav>
  </section>
</Layout>
