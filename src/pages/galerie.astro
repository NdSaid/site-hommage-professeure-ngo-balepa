---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import captions from "../data/captions.json";

// Toute image déposée dans src/assets/galerie/ apparaît ici.
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/galerie/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);

const legendes = captions as Record<string, string>;

const photos = Object.entries(files)
  .map(([path, mod]) => {
    const filename = path.split("/").pop()!;
    return { filename, image: mod.default, legende: legendes[filename] };
  })
  .sort((a, b) => a.filename.localeCompare(b.filename));

// Le prototype montre six cadres ; on complète la grille tant que les
// photographies réelles n'ont pas été fournies.
const placeholders = Math.max(0, 6 - photos.length);
---

<Layout
  title="Galerie"
  description="Photographies de la Professeure Aurore Sara Ngo Balepa."
>
  <div class="view">
    <PageHeader eyebrow="Galerie · Gallery" title="En images" />

    <ul
      class="mt-12 grid list-none gap-5 p-0"
      style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));"
    >
      {
        photos.map(({ filename, image, legende }) => (
          <li>
            <figure class="m-0">
              <button
                type="button"
                class="block w-full cursor-zoom-in border border-line bg-paper p-0"
                style="aspect-ratio: 3/4;"
                data-lightbox={image.src}
                data-caption={legende ?? ""}
                aria-label={`Agrandir : ${legende ?? filename}`}
              >
                <Image
                  src={image}
                  alt={legende ?? filename}
                  widths={[300, 600]}
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 45vw, 90vw"
                  class="h-full w-full object-cover"
                />
              </button>
              {legende && (
                <figcaption class="mt-2.5 text-[12px] text-muted">
                  {legende}
                </figcaption>
              )}
            </figure>
          </li>
        ))
      }
      {
        Array.from({ length: placeholders }).map(() => (
          <li>
            <div
              class="flex items-center justify-center border border-line bg-paper p-4 text-center text-[12px] text-muted"
              style="aspect-ratio: 3/4;"
              aria-hidden="true"
            >
              src/assets/galerie/
            </div>
          </li>
        ))
      }
    </ul>

    {
      photos.length === 0 && (
        <p class="pending mt-8">
          Aucune photographie pour l'instant. Déposer les fichiers dans
          src/assets/galerie/ ; les légendes se renseignent dans
          src/data/captions.json.
        </p>
      )
    }
  </div>

  <!-- Lightbox : prévue par le handoff, absente du prototype. -->
  <dialog
    id="lightbox"
    class="m-auto max-h-[92vh] max-w-[92vw] border border-line bg-canvas p-0 backdrop:bg-ink/70"
  >
    <button
      type="button"
      id="lightbox-close"
      class="btn btn-secondary absolute top-3 right-3 z-10 px-3 py-1 text-[13px]"
      aria-label="Fermer"
    >
      Fermer
    </button>
    <img id="lightbox-img" src="" alt="" class="max-h-[80vh] w-auto" />
    <p id="lightbox-caption" class="m-0 px-4 py-3 text-[13px] text-muted"></p>
  </dialog>

  <script>
    const dialog = document.getElementById(
      "lightbox",
    ) as HTMLDialogElement | null;
    const img = document.getElementById(
      "lightbox-img",
    ) as HTMLImageElement | null;
    const caption = document.getElementById("lightbox-caption");

    if (dialog && img && caption) {
      document
        .querySelectorAll<HTMLElement>("[data-lightbox]")
        .forEach((el) => {
          el.addEventListener("click", () => {
            img.src = el.dataset.lightbox ?? "";
            img.alt = el.dataset.caption ?? "";
            caption.textContent = el.dataset.caption ?? "";
            dialog.showModal();
          });
        });

      document
        .getElementById("lightbox-close")
        ?.addEventListener("click", () => dialog.close());

      // Clic hors de l'image : fermer.
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
    }
  </script>
</Layout>
