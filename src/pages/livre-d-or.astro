---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../config";

// Messages déjà relus et publiés. Le formulaire ci-dessous n'écrit pas
// directement ici : le handoff demande une modération avant publication.
const messages = await getCollection("messages");
messages.sort((a, b) => {
  const at = a.data.date?.getTime() ?? 0;
  const bt = b.data.date?.getTime() ?? 0;
  return bt - at;
});

const rendered = await Promise.all(
  messages.map(async (message) => ({
    ...message,
    Content: (await render(message)).Content,
  })),
);

const champs = [
  {
    id: "nom",
    label: "Votre nom",
    placeholder: "Nom et prénom",
    type: "text" as const,
  },
  {
    id: "lien",
    label: "Lien avec elle",
    placeholder: "Ancien étudiant, collègue, famille…",
    type: "text" as const,
  },
];
---

<Layout
  title="Livre d'or"
  description="Laisser un message en hommage à la Professeure Aurore Sara Ngo Balepa."
>
  <div class="view">
    <PageHeader
      eyebrow="Livre d'or · Guest book"
      title="Laisser un message"
      titleWidth="16ch"
    />

    <p class="mt-6 text-muted" style="max-width: 52ch;">
      Collègues, étudiants, proches : partagez un souvenir ou un mot d'hommage.
    </p>

    <div
      class="mt-12 grid items-start gap-[clamp(32px,5vw,64px)]"
      style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));"
    >
      <!-- Formulaire -->
      <div class="border border-line bg-paper p-7">
        {
          site.guestbookEndpoint ? (
            <form
              method="POST"
              action={site.guestbookEndpoint}
              class="grid gap-[18px]"
            >
              {champs.map(({ id, label, placeholder, type }) => (
                <div>
                  <label
                    for={id}
                    class="mb-1.5 block text-[12px] text-muted uppercase"
                    style="letter-spacing: 0.08em;"
                  >
                    {label}
                  </label>
                  <input
                    id={id}
                    name={id}
                    type={type}
                    placeholder={placeholder}
                    class="w-full border border-line bg-canvas px-3 py-2.5 text-[15px] text-ink"
                  />
                </div>
              ))}

              <div>
                <label
                  for="message"
                  class="mb-1.5 block text-[12px] text-muted uppercase"
                  style="letter-spacing: 0.08em;"
                >
                  Votre message
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  placeholder="Un souvenir, un mot…"
                  class="w-full resize-y border border-line bg-canvas px-3 py-2.5 text-[15px] text-ink"
                  style="min-height: 130px;"
                />
              </div>

              {/* Anti-spam : piège masqué, ignoré des lecteurs d'écran. */}
              <p class="absolute -left-[9999px]" aria-hidden="true">
                <label for="site-web">Ne pas remplir</label>
                <input
                  id="site-web"
                  name="site-web"
                  type="text"
                  tabindex="-1"
                  autocomplete="off"
                />
              </p>

              <button type="submit" class="btn btn-primary w-full">
                Publier le message
              </button>

              <p class="m-0 text-[13px] text-muted">
                Les messages sont relus avant d'être publiés sur cette page.
              </p>
            </form>
          ) : (
            <div>
              <p class="mt-0 text-[15px] text-muted">
                L'envoi de messages depuis le site n'est pas encore activé.
                {site.contactEmail ? (
                  <>
                    {" "}
                    En attendant, les hommages peuvent être adressés à{" "}
                    <a href={`mailto:${site.contactEmail}`}>
                      {site.contactEmail}
                    </a>
                    .
                  </>
                ) : (
                  " En attendant, les hommages peuvent être recueillis par courriel."
                )}
              </p>
              <p class="pending mb-0">
                Pour activer le formulaire : renseigner guestbookEndpoint dans
                src/config.ts (voir la section « Livre d'or » du README).
              </p>
            </div>
          )
        }
      </div>

      <!-- Messages publiés -->
      <div>
        {
          rendered.length === 0 ? (
            <p class="pending">
              Aucun message publié pour l'instant. Les hommages relus se
              déposent dans src/content/messages/.
            </p>
          ) : (
            <ul class="list-none p-0">
              {rendered.map(({ id, data, Content }) => (
                <li id={id} class="border-t border-line py-[26px]">
                  <blockquote class="lede m-0 text-[19px] [&_p:last-child]:mb-0">
                    <Content />
                  </blockquote>
                  <p class="mt-3 mb-0 text-[13px] text-muted">
                    {data.nom} — {data.lien}
                  </p>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </div>
</Layout>
