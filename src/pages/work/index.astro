---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import WorkEntry from "../../components/WorkEntry.astro";

const works = await getCollection("works");

// Newest first; featured entries float to the top of their year.
works.sort((a, b) => {
  if (a.data.year !== b.data.year) return b.data.year - a.data.year;
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.title.localeCompare(b.data.title);
});

const byYear = new Map<number, typeof works>();
for (const work of works) {
  const bucket = byYear.get(work.data.year) ?? [];
  bucket.push(work);
  byYear.set(work.data.year, bucket);
}
const years = [...byYear.keys()];
---

<Layout
  title="Her Work"
  description="A collected archive of her publications, books, and talks."
>
  <PageHeader
    title="Her Work"
    lede="A collected record of what she wrote, argued, and taught — gathered here so it stays findable."
  />

  <div class="mx-auto max-w-5xl px-6">
    {
      years.length === 0 ? (
        <div class="rounded-sm border border-dashed border-rule bg-parchment-deep p-8 text-sm text-ink-soft">
          <p class="font-serif text-base text-ink">
            No work has been added yet.
          </p>
          <p class="mt-3">
            Add an entry by creating a Markdown file in
            <code class="text-ink">src/content/works/</code>. See
            <code class="text-ink">src/content/works/example.md</code> for the
            fields available.
          </p>
        </div>
      ) : (
        <>
          <p class="text-sm text-ink-faint">
            {works.length} {works.length === 1 ? "entry" : "entries"},{" "}
            {years.at(-1)}–{years[0]}
          </p>

          {years.map((year) => (
            <section class="mt-14">
              <h2 class="font-serif text-2xl text-ink tabular-nums">{year}</h2>
              <ul class="mt-6 divide-y divide-rule border-t border-rule">
                {byYear.get(year)!.map((work) => (
                  <WorkEntry work={work} />
                ))}
              </ul>
            </section>
          ))}
        </>
      )
    }
  </div>
</Layout>
