---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Timeline from "../components/Timeline.astro";
import { education, appointments, honors } from "../data/career";
---

<Layout
  title="Education & Career"
  description="Degrees, academic appointments, and honors."
>
  <PageHeader
    title="Education & Career"
    lede="The path of a life in the university — where she studied, where she taught, and how her field recognized her."
  />

  <div class="mx-auto max-w-5xl px-6">
    <Timeline heading="Education" entries={education} />
    <Timeline heading="Academic Appointments" entries={appointments} />
    <Timeline heading="Honors & Distinctions" entries={honors} />
  </div>
</Layout>
