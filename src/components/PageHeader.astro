---
interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<div class="mx-auto max-w-5xl px-6 pt-16 pb-10 sm:pt-24">
  <h1 class="font-serif text-4xl leading-tight text-ink sm:text-5xl">
    {title}
  </h1>
  {lede && <p class="prose-memorial mt-5 text-lg">{lede}</p>}
  <div class="mt-10 h-px w-24 bg-accent-soft"></div>
</div>
