---
interface Props {
  /** Sur-titre ocre, ex. « Biographie · Biography ». */
  eyebrow: string;
  title: string;
  /** Largeur maximale du H1, en ch. */
  titleWidth?: string;
}
const { eyebrow, title, titleWidth } = Astro.props;
---

<p class="eyebrow">{eyebrow}</p>
<h1 class="h1" style={titleWidth ? `max-width: ${titleWidth};` : undefined}>
  {title}
</h1>
