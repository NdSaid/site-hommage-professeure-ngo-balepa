---
import Frame from "../Frame.astro";
import { path, t, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).home;
---

<!-- Hero -->
<section
  class="mx-auto grid max-w-[1180px] items-end gap-[clamp(36px,5vw,72px)] px-[clamp(20px,4vw,40px)] pt-[clamp(56px,8vw,104px)] pb-[clamp(48px,6vw,80px)]"
  style="grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));"
>
  <div>
    <p class="eyebrow">{d.eyebrow}</p>
    <h1 class="mb-7 text-[clamp(40px,6.4vw,72px)]" style="max-width: 12ch;">
      {d.title}
    </h1>

    <p class="lede text-[clamp(17px,1.8vw,20px)]" style="max-width: 48ch;">
      {d.lede}
    </p>
    {
      d.ledeAlt && (
        <p class="mt-3 text-[15px] text-muted italic" style="max-width: 48ch;">
          {d.ledeAlt}
        </p>
      )
    }

    <div class="mt-[34px] flex flex-wrap gap-2.5">
      <a href={path(lang, "biography")} class="btn btn-primary no-underline">
        {d.ctaPrimary}
      </a>
      <a href={path(lang, "guestbook")} class="btn btn-secondary no-underline">
        {d.ctaSecondary}
      </a>
    </div>
  </div>

  <Frame
    name="portrait"
    ratio="4/5"
    alt={d.title}
    caption={d.portraitCaption}
  />
</section>

<!-- Bandeau thèmes -->
<section class="border-y border-line bg-paper">
  <div
    class="mx-auto grid max-w-[1180px] gap-10 px-[clamp(20px,4vw,40px)] py-[clamp(40px,5vw,64px)]"
    style="grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));"
  >
    {
      d.themes.map((theme) => (
        <div>
          <h2 class="font-serif text-[26px]">{theme.title}</h2>
          <p class="mt-3 mb-0 text-[15px] text-muted">{theme.text}</p>
        </div>
      ))
    }
  </div>
</section>

<!-- Un enseignement, une école -->
<section
  class="mx-auto grid max-w-[1180px] items-center gap-[clamp(36px,5vw,72px)] px-[clamp(20px,4vw,40px)] py-[clamp(56px,7vw,96px)]"
  style="grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));"
>
  <div>
    <h2 class="h2" style="max-width: 14ch;">{d.schoolTitle}</h2>
    <p class="mt-6 text-muted" style="max-width: 40ch;">{d.schoolText}</p>
    <a href={path(lang, "research")} class="link-underline no-underline">
      {d.schoolLink}
    </a>
  </div>

  <Frame
    name="enseignement"
    ratio="16/10"
    alt={d.schoolTitle}
    caption={d.schoolCaption}
  />
</section>
