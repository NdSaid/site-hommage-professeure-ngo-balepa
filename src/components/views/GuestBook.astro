---
import { getCollection, render } from "astro:content";
import PageHeader from "../PageHeader.astro";
import { site } from "../../config";
import { t, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).guestbook;

// Messages déjà relus et publiés. Le formulaire n'écrit jamais ici :
// le handoff impose une modération avant publication.
const messages = await getCollection("messages");
messages.sort((a, b) => {
  const at = a.data.date?.getTime() ?? 0;
  const bt = b.data.date?.getTime() ?? 0;
  return bt - at;
});

const rendered = await Promise.all(
  messages.map(async (message) => ({
    ...message,
    Content: (await render(message)).Content,
  })),
);

const champs = [
  { id: "nom", ...d.fields.name },
  { id: "lien", ...d.fields.relation },
] as const;
---

<div class="view">
  <PageHeader eyebrow={d.eyebrow} title={d.title} titleWidth="16ch" />

  <p class="mt-6 text-muted" style="max-width: 52ch;">{d.intro}</p>

  <div
    class="mt-12 grid items-start gap-[clamp(32px,5vw,64px)]"
    style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));"
  >
    <div class="border border-line bg-paper p-7">
      {
        site.guestbookEndpoint ? (
          <form
            id="guestbook-form"
            method="POST"
            action={site.guestbookEndpoint}
            class="grid gap-[18px]"
          >
            {champs.map(({ id, label, placeholder }) => (
              <div>
                <label
                  for={id}
                  class="mb-1.5 block text-[12px] text-muted uppercase"
                  style="letter-spacing: 0.08em;"
                >
                  {label}
                </label>
                <input
                  id={id}
                  name={id}
                  type="text"
                  placeholder={placeholder}
                  class="w-full border border-line bg-canvas px-3 py-2.5 text-[15px] text-ink"
                />
              </div>
            ))}

            <div>
              <label
                for="message"
                class="mb-1.5 block text-[12px] text-muted uppercase"
                style="letter-spacing: 0.08em;"
              >
                {d.fields.message.label}
              </label>
              <textarea
                id="message"
                name="message"
                required
                placeholder={d.fields.message.placeholder}
                class="w-full resize-y border border-line bg-canvas px-3 py-2.5 text-[15px] text-ink"
                style="min-height: 130px;"
              />
            </div>

            {/* Anti-spam : piège masqué, ignoré des lecteurs d'écran. */}
            <p class="absolute -left-[9999px]" aria-hidden="true">
              <label for="site-web">{d.honeypot}</label>
              <input
                id="site-web"
                name="site-web"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </p>

            <button
              type="submit"
              id="guestbook-submit"
              class="btn btn-primary w-full"
              data-idle={d.submit}
              data-busy={d.submitting}
            >
              {d.submit}
            </button>

            {/* États d'envoi — absents du prototype, demandés au handoff. */}
            <p
              id="guestbook-status"
              role="status"
              aria-live="polite"
              class="m-0 hidden text-[13px]"
              data-success={d.success}
              data-error={d.error}
            />

            <p class="m-0 text-[13px] text-muted">{d.moderation}</p>
          </form>
        ) : (
          <div>
            <p class="mt-0 text-[15px] text-muted">
              {d.disabled}{" "}
              {site.contactEmail ? (
                <>
                  {d.disabledContact}{" "}
                  <a href={`mailto:${site.contactEmail}`}>
                    {site.contactEmail}
                  </a>
                  .
                </>
              ) : (
                d.disabledNoContact
              )}
            </p>
            <p class="pending mb-0">{d.disabledPending}</p>
          </div>
        )
      }
    </div>

    <div>
      {
        rendered.length === 0 ? (
          <p class="pending">{d.empty}</p>
        ) : (
          <ul class="list-none p-0">
            {rendered.map(({ id, data, Content }) => (
              <li id={id} class="border-t border-line py-[26px]">
                <blockquote class="lede m-0 text-[19px] [&_p:last-child]:mb-0">
                  <Content />
                </blockquote>
                <p class="mt-3 mb-0 text-[13px] text-muted">
                  {data.nom} — {data.lien}
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</div>

<script>
  // Amélioration progressive : sans JavaScript, le formulaire se poste
  // normalement vers l'endpoint et l'utilisateur voit la page du service.
  const form = document.getElementById(
    "guestbook-form",
  ) as HTMLFormElement | null;
  const button = document.getElementById(
    "guestbook-submit",
  ) as HTMLButtonElement | null;
  const status = document.getElementById("guestbook-status");

  if (form && button && status) {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      button.disabled = true;
      button.textContent = button.dataset.busy ?? "";
      status.classList.add("hidden");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(String(response.status));

        form.reset();
        status.textContent = status.dataset.success ?? "";
        status.className = "m-0 text-[13px] text-green";
      } catch {
        status.textContent = status.dataset.error ?? "";
        status.className = "m-0 text-[13px] text-ochre";
      } finally {
        button.disabled = false;
        button.textContent = button.dataset.idle ?? "";
        status.classList.remove("hidden");
      }
    });
  }
</script>
