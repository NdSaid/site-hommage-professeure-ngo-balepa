---
import PageHeader from "../PageHeader.astro";
import { etapes } from "../../data/carriere";
import { t, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).career;
---

<div class="view">
  <PageHeader eyebrow={d.eyebrow} title={d.title} />

  <ol class="mt-12 list-none p-0" style="max-width: 840px;">
    {
      etapes.map((etape) => (
        <li
          class="grid gap-[clamp(16px,3vw,36px)] border-t border-line py-[26px]"
          style="grid-template-columns: minmax(78px, 140px) 1fr;"
        >
          <p class="m-0 font-serif text-[19px] text-ochre">
            {etape.annee[lang]}
          </p>
          <div>
            <h2 class="font-serif text-[20px]">{etape.poste[lang]}</h2>
            <p class="mt-1.5 mb-0 text-[15px] text-muted">
              {etape.precision[lang]}
            </p>
          </div>
        </li>
      ))
    }
  </ol>

  <p class="pending mt-8">{d.pending}</p>
</div>
