---
import { site } from "../config";
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<footer class="mt-auto border-t border-line bg-paper">
  <div
    class="mx-auto flex max-w-[1180px] flex-wrap items-baseline justify-between gap-4 px-[clamp(20px,4vw,40px)] py-9"
  >
    <p class="font-serif text-[18px] text-ink">{site.shortName}</p>
    <p class="text-[13px] text-muted">{d.footer.line}</p>
  </div>
</footer>
