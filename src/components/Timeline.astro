---
import type { Entry } from "../data/career";

interface Props {
  heading: string;
  entries: Entry[];
}
const { heading, entries } = Astro.props;
---

<section class="mt-16 first:mt-0">
  <h2 class="font-serif text-2xl text-ink">{heading}</h2>

  <ol class="mt-8 border-l border-rule">
    {
      entries.map((entry) => (
        <li class="relative pb-10 pl-8 last:pb-0">
          <span
            class="absolute top-2 -left-[5px] h-[9px] w-[9px] rounded-full bg-accent-soft"
            aria-hidden="true"
          />
          <p class="font-sans text-sm tracking-wide text-ink-faint tabular-nums">
            {entry.period}
          </p>
          <h3 class="mt-1 font-serif text-lg text-ink">{entry.title}</h3>
          {entry.place && (
            <p class="mt-0.5 text-sm text-ink-soft">{entry.place}</p>
          )}
          {entry.note && (
            <p class="prose-memorial mt-3 text-[0.95rem]">{entry.note}</p>
          )}
        </li>
      ))
    }
  </ol>
</section>
