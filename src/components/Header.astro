---
import { site } from "../config";
import {
  otherLang,
  path,
  routeKeys,
  t,
  type Lang,
  type RouteKey,
} from "../i18n";

interface Props {
  lang: Lang;
  route: RouteKey;
}
const { lang, route } = Astro.props;
const d = t(lang);
const other = otherLang(lang);
---

<header
  class="relative z-20 border-b border-line sm:sticky sm:top-0"
  style="background: color-mix(in srgb, #f7f5f0 94%, transparent); backdrop-filter: blur(8px);"
>
  <div
    class="mx-auto flex max-w-[1180px] flex-wrap items-baseline gap-x-7 gap-y-3 px-[clamp(20px,4vw,40px)] py-4"
  >
    <a href={path(lang, "home")} class="mr-auto no-underline">
      <span class="block font-serif text-[19px] text-ink">{site.name}</span>
      <span class="label mt-0.5 block text-muted">{d.header.affiliation}</span>
    </a>

    <nav aria-label={d.header.navLabel}>
      <ul class="flex flex-wrap items-baseline">
        {
          routeKeys.map((key) => (
            <li>
              <a
                href={path(lang, key)}
                aria-current={key === route ? "page" : undefined}
                class:list={[
                  "block px-3 py-[7px] text-[14px] no-underline transition-colors duration-[120ms] hover:bg-paper",
                  key === route ? "text-green" : "text-muted hover:text-muted",
                ]}
              >
                {d.nav[key]}
              </a>
            </li>
          ))
        }
        <li class="ml-2 border-l border-line pl-2">
          <a
            href={path(other, route)}
            lang={other}
            aria-label={d.switcher.aria}
            class="block px-3 py-[7px] text-[14px] text-muted no-underline transition-colors duration-[120ms] hover:bg-paper hover:text-muted"
          >
            {d.switcher.label}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
