---
import { site, nav } from "../config";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-20 border-b border-line"
  style="background: color-mix(in srgb, #f7f5f0 94%, transparent); backdrop-filter: blur(8px);"
>
  <div
    class="mx-auto flex max-w-[1180px] flex-wrap items-baseline gap-x-7 gap-y-3 px-[clamp(20px,4vw,40px)] py-4"
  >
    <a href="/" class="mr-auto no-underline">
      <span class="block font-serif text-[19px] text-ink">{site.name}</span>
      <span class="label mt-0.5 block text-muted">{site.affiliation}</span>
    </a>

    <nav aria-label="Navigation principale">
      <ul class="flex flex-wrap items-baseline">
        {
          nav.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? "page" : undefined}
                class:list={[
                  "block px-3 py-[7px] text-[14px] no-underline transition-colors duration-[120ms] hover:bg-paper",
                  isActive(href) ? "text-green" : "text-muted hover:text-muted",
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
