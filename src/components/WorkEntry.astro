---
import type { CollectionEntry } from "astro:content";

interface Props {
  work: CollectionEntry<"works">;
}
const { work } = Astro.props;
const { title, venue, authors, type, doi, url, pdf } = work.data;

const typeLabel: Record<string, string> = {
  article: "Article",
  book: "Book",
  chapter: "Chapter",
  talk: "Talk",
  thesis: "Thesis",
  other: "",
};
---

<li class="py-6">
  <div class="flex flex-wrap items-baseline gap-x-3">
    <h3 class="font-serif text-lg leading-snug text-ink">
      <a href={`/work/${work.id}/`} class="transition-colors hover:text-accent">
        {title}
      </a>
    </h3>
    {
      typeLabel[type] && (
        <span class="rounded-sm bg-parchment-deep px-2 py-0.5 text-xs tracking-wide text-ink-faint uppercase">
          {typeLabel[type]}
        </span>
      )
    }
  </div>

  {
    authors.length > 0 && (
      <p class="mt-2 text-sm text-ink-soft">{authors.join(", ")}</p>
    )
  }
  {venue && <p class="mt-1 text-sm text-ink-faint italic">{venue}</p>}

  {
    (doi || url || pdf) && (
      <p class="mt-3 flex flex-wrap gap-x-5 text-sm">
        {pdf && (
          <a href={pdf} class="text-accent underline underline-offset-4">
            PDF
          </a>
        )}
        {url && (
          <a
            href={url}
            rel="noopener"
            class="text-accent underline underline-offset-4"
          >
            Read online
          </a>
        )}
        {doi && (
          <a
            href={`https://doi.org/${doi}`}
            rel="noopener"
            class="text-accent underline underline-offset-4"
          >
            doi:{doi}
          </a>
        )}
      </p>
    )
  }
</li>
